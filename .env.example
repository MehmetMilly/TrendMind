# Database mode: auto, pglite, or pg.
# Use pglite for local demos without a cloud database.
TRENDMIND_DB_MODE=pglite

# Required only when TRENDMIND_DB_MODE=pg or when auto should use Postgres.
DATABASE_URL=

# Optional AI and research integrations.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-3.1-pro
OPENROUTER_FALLBACK_MODEL=google/gemini-2.5-flash
OPENROUTER_TIMEOUT_MS=240000
TAVILY_API_KEY=

# Keep false unless deliberately developing fallback-only behavior.
TRENDMIND_ALLOW_SYNTHETIC_FALLBACKS=false

NEXT_PUBLIC_APP_URL=http://localhost:3000
